DATABASE_URL=postgresql+asyncpg://raw:rawpass@db:5432/raw_timesheet

# Security - CHANGE THESE IN PRODUCTION
JWT_SECRET_KEY=generate-a-long-random-string-here
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-to-strong-password

# Email (SMTP)
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_USERNAME=accounts@rawlabourhire.com
SMTP_PASSWORD=change-this
SMTP_FROM=RAW Labour Hire <accounts@rawlabourhire.com>
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# SMS (Cellcast - Australian gateway, AUD-billed). Used as the FALLBACK channel only;
# notifications are sent as free in-app push first.
CELLCAST_API_KEY=your_cellcast_appkey
# Optional custom Sender ID (e.g. "RAW Labour"). Max 11 chars (alpha) / 16 digits.
# NOTE: a custom sender ID costs 1.3 credits/SMS vs 1 credit for the shared number, and
# is ONE-WAY (recipients can't reply). Leave blank to use the cheapest shared number;
# the company name is added to the message body regardless.
CELLCAST_SENDER_ID=

RESET_URL_BASE=https://rawlabourhire.com/reset-password
