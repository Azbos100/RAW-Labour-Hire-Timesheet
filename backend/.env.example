DATABASE_URL=postgresql+asyncpg://raw:rawpass@db:5432/raw_timesheet

# Security - CHANGE THESE IN PRODUCTION
JWT_SECRET_KEY=generate-a-long-random-string-here
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-to-strong-password

# Email (SMTP)
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_USERNAME=accounts@rawlabourhire.com
SMTP_PASSWORD=change-this
SMTP_FROM=RAW Labour Hire <accounts@rawlabourhire.com>
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# SMS (Twilio)
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+61xxxxxxxxx
# Optional: show this name as the SMS sender instead of the number (max 11 chars,
# must contain a letter). Alphanumeric sender IDs are ONE-WAY - recipients can't reply.
TWILIO_SENDER_ID=RAW Labour

RESET_URL_BASE=https://rawlabourhire.com/reset-password
